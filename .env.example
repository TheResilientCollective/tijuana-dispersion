# tijuana-dispersion environment template
# Copy to .env for local development; never commit .env itself.

# Cache directory for forward-run results.
# Local default: ./.cache
# Railway default (with mounted volume): /app/.cache
DISPERSION_CACHE_DIR=./.cache

# Port for uvicorn (Railway sets PORT automatically).
PORT=8765

# Optional: bearer token for any authenticated endpoints (none currently exist).
# DISPERSION_AUTH_TOKEN=

# Optional: URL for a remote HYSPLIT/STILT backend, used by the ensemble dispatcher.
# HYSPLIT_REMOTE_URL=https://hysplit.example.com
# HYSPLIT_REMOTE_TOKEN=

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
