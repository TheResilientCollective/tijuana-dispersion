# Base URL for the public object store the map reads from.
#
# resilientpublic is the public bucket and the intended source. It is empty
# until the pipelines are repointed at it (see docs/mapinterface_plan.md in
# tijuana-dispersion, section 5 A), so override this with the bucket the
# pipelines currently write to if you want real data on screen today.
VITE_DATA_BASE=https://oss.resilientservice.mooo.com/resilientpublic
# VITE_DATA_BASE=https://oss.resilientservice.mooo.com/test
# VITE_DATA_BASE=/data   # local fixtures from ./scripts/mirror-fixtures.sh

# MapLibre style URL. No API key required for the CARTO basemaps.
# Swap for a self-hosted PMTiles style to drop the third-party dependency.
VITE_BASEMAP_STYLE=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
# VITE_BASEMAP_STYLE=./basemap/offline-style.json   # offline, from the mirror script
